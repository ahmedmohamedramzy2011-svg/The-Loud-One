# Optional WebRTC TURN Relay & Signaling Config for Internet Multiplayer
# Configure ONE of the TURN providers below in Vercel / host environment variables
# so players behind strict routers, symmetric NATs, or mobile data can connect.

# 1. Primary Metered / Custom Static TURN (pushed first; comma-separated turn:/turns: URLs)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# 2. Secondary Metered / Backup Static TURN (pushed second)
TURN_URL_2=
TURN_USERNAME_2=
TURN_CREDENTIAL_2=

# Optional Dynamic Metered Global TURN API (20 GB/month at metered.ca)
METERED_DOMAIN=
METERED_API_KEY=

# 3. Cloudflare Calls TURN final fallback (1,000 GB/month; pushed third by default)
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_TTL=
# metered-first (default: Primary Metered -> Secondary Metered -> Cloudflare) | cloudflare-first | cloudflare-only | metered-only
TURN_PRIORITY=

# Optional: Self-hosted PeerJS signaling server (leave blank for default cloud signaling)
PEER_HOST=
PEER_PORT=
PEER_PATH=
PEER_SECURE=
PEER_KEY=

# Optional: Redis/KV REST store for live multiplayer session registry across serverless instances
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
