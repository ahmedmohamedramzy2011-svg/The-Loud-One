# Optional WebRTC TURN Relay & Signaling Config for Internet Multiplayer
# Configure ONE of the TURN providers below in Vercel / host environment variables
# so players behind strict routers, symmetric NATs, or mobile data can connect.

# Option 1: Metered Global TURN (Free tier: 20 GB/month at metered.ca)
METERED_DOMAIN=
METERED_API_KEY=

# Option 2: Cloudflare Calls TURN fallback/primary (Free tier: 1,000 GB/month)
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_TTL=
# metered-first (default, falls back to Cloudflare automatically) | cloudflare-first | cloudflare-only | metered-only
TURN_PRIORITY=

# Option 3: Self-hosted Coturn (comma-separated turn:/turns: URLs)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional: Self-hosted PeerJS signaling server (leave blank for default cloud signaling)
PEER_HOST=
PEER_PORT=
PEER_PATH=
PEER_SECURE=
PEER_KEY=

# Optional: Redis/KV REST store for live multiplayer session registry across serverless instances
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
